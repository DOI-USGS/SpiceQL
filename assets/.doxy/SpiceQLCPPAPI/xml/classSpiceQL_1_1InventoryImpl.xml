      <memberdef kind="function" id="classSpiceQL_1_1InventoryImpl_1a10bcf75c1fa16a4cdd404fbc6ddb0e07" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>nlohmann::json</type>
        <definition>nlohmann::json SpiceQL::InventoryImpl::get_group_intervals</definition>
        <argsstring>(std::string key, std::vector&lt; std::string &gt; kernels)</argsstring>
        <name>get_group_intervals</name>
        <qualifiedname>SpiceQL::InventoryImpl::get_group_intervals</qualifiedname>
        <param>
          <type>std::string</type>
          <declname>key</declname>
        </param>
        <param>
          <type>std::vector&lt; std::string &gt;</type>
          <declname>kernels</declname>
        </param>
        <briefdescription>
<para>Get the coverage intervals of kernels in one CK or SPK group. </para>
        </briefdescription>
        <detaileddescription>
<para>Used when the group is already known, e.g. by search_for_kernelset. To search every group, use get_kernel_intervals.</para>
<para>A kernel can be named by its bare filename, its path relative to the data dir (or a full path ending in it), or its <ref refid="namespaceSpiceQL" kindref="compound">SpiceQL</ref> key (/&lt;mission&gt;/&lt;type&gt;/&lt;quality&gt;/&lt;filename&gt;). Kernels not in the group are skipped.</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>key</parametername>
</parameternamelist>
<parameterdescription>
<para>the group, as &lt;mission&gt;/&lt;type&gt;/&lt;quality&gt;/ </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>kernels</parametername>
</parameternamelist>
<parameterdescription>
<para>the kernels to get intervals for </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>json object of <ref refid="namespaceSpiceQL" kindref="compound">SpiceQL</ref> key to an array of {&quot;start&quot;, &quot;stop&quot;, &quot;body_code&quot;} intervals </para>
</simplesect>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
        <location file="SpiceQL/include/SpiceQL/inventoryimpl.h" line="117" column="20"/>
      </memberdef>
      <memberdef kind="function" id="classSpiceQL_1_1InventoryImpl_1abd1de83426780735d971ca6aabe7f23f" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
